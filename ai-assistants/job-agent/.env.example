# Скопіюй у .env і заповни.
TELEGRAM_BOT_TOKEN=123456:ABC...        # від @BotFather
TELEGRAM_CHAT_ID=                       # напиши боту /start — він покаже твій id

# LLM оцінює вакансії і пише листи. Варіанти:
#   gemini    — ключ з aistudio.google.com (є безкоштовний ліміт)
#   anthropic / openai — платний ключ
#   local     — Ollama / LM Studio на цьому комп'ютері, без ключа і безкоштовно
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=                              # порожньо = модель за замовчуванням
LLM_EFFORT=                             # anthropic: low | medium | high
LLM_BASE_URL=                           # для local: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1

TZ=Europe/Kyiv
