#!/bin/bash
# Двойной клик: окно переводчика (версия на Rust) — язык перевода, микрофон,
# наушники, индикаторы голоса. Держите правый ⌥ (Option) и говорите.
# При первом запуске программа собирается (~2 мин), потом стартует сразу.
cd "$(dirname "$0")"
CARGO="$HOME/.cargo/bin/cargo"
if [ ! -x "$CARGO" ]; then
    echo "Не найден Rust ($CARGO). Установка: https://rustup.rs"
    read -n 1 -s -r -p "Нажмите любую клавишу…"; exit 1
fi
echo "Проверяю, свежая ли сборка (после изменений в коде пересборка ~1 мин, окно откроется само)…"
"$CARGO" build --release || { read -n 1 -s -r -p "Сборка не удалась. Нажмите любую клавишу…"; exit 1; }
echo "Открываю окно…"
exec ./target/release/pressvoice-live "$@"
