{
  "manifest_version": 3,
  "name": "На телевизор (LG)",
  "version": "1.0.0",
  "description": "Кнопка «На телевизор» на YouTube: видео сразу играет в приложении YouTube на телевизоре LG с той же секунды.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "На телевизор",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "cast-to-tv": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Отправить текущее видео на телевизор"
    }
  }
}